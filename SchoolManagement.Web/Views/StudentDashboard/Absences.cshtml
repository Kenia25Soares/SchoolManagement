@model StudentAbsencesViewModel

@{
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
    ViewData["Title"] = "Absences for " + Model.StudentName;
}

<div class="container-fluid">
    <h2>Absences for @Model.StudentName</h2>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Absences for @Model.StudentName</h5>

                    @if (!Model.Absences.Any())
                    {
                        <div class="alert alert-info">No absences recorded.</div>
                    }
                    else
                    {
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Total Absences</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var absence in Model.Absences)
                                {
                                    <tr>
                                        <td>@absence.SubjectName</td>
                                        <td>@absence.TotalAbsences</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Grades</a>
                </div>
            </div>
        </div>
    </div>
</div>
