@using SchoolManagement.Web.Data.Enums
@model SchoolManagement.Web.Models.CreateAlertViewModel

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <h4 class="text-center mb-4">Create New Alert</h4>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" autocomplete="off" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" autocomplete="off"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<AlertPriority>()"></select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <ejs-button id="btnSaveAlert"
                            type="submit"
                            content="Save"
                            iconCss="fas fa-save"
                            cssClass="e-success e-plus"
                            iconPosition="Left">
                </ejs-button>

                <ejs-button id="btnCancelAlert"
                            type="button"
                            content="Cancel"
                            iconCss="fas fa-arrow-left"
                            cssClass="e-secondary e-plus"
                            iconPosition="Left"
                            onclick="location.href='/EmployeeDashboard/Index'">
                </ejs-button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
