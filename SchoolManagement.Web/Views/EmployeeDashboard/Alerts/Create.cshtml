@using SchoolManagement.Web.Data.Enums
@model SchoolManagement.Web.Models.CreateAlertViewModel

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <h4>Create New Alert</h4>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<AlertPriority>()"></select>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-controller="EmployeeDashboard" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
