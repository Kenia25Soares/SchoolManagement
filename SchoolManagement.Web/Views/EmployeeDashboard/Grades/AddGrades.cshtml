@model AddGradesViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Grades for Student";

    string GetSubjectOptions(int selectedId)
    {
        var options = "";
        foreach (var s in Model.Subjects)
        {
            var selected = s.Value == selectedId.ToString() ? "selected" : "";
            options += $"<option value='{s.Value}' {selected}>{s.Text}</option>";
        }
        return options;
    }

    string GetGradeTypeOptions(int selectedId)
    {
        var options = "";
        foreach (var gt in Model.GradeTypes)
        {
            var selected = gt.Value == selectedId.ToString() ? "selected" : "";
            options += $"<option value='{gt.Value}' {selected}>{gt.Text}</option>";
        }
        return options;
    }
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Add grades for <strong>@ViewBag.StudentName</strong> here.</p>

    <form asp-action="AddGrades" method="post">
        <input type="hidden" asp-for="StudentId" />

        <table class="table table-bordered" id="gradesTable">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Grade Type</th>
                    <th>Grade</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Grades.Count; i++)
                {
                    <tr>
                        <td>
                            <select name="Grades[@i].SubjectId" class="form-select" required>
                                <option value="">-- Select Subject --</option>
                                @Html.Raw(GetSubjectOptions(Model.Grades[i].SubjectId))
                            </select>
                        </td>
                        <td>
                            <select name="Grades[@i].GradeTypeId" class="form-select" required>
                                <option value="">-- Select Grade Type --</option>
                                @Html.Raw(GetGradeTypeOptions(Model.Grades[i].GradeTypeId))
                            </select>
                        </td>
                        <td>
                            <input name="Grades[@i].Grade" class="form-control" type="number" step="0.01" min="0" max="20" value="@Model.Grades[i].Grade" />
                        </td>
                        <td id="removeBtnCell-@i" class="d-flex justify-content-center align-items-center py-2">
                            <ejs-button id="btnRemoveRow-@i"
                                        type="button"
                                        iconCss="fas fa-minus"
                                        cssClass="e-danger e-plus"
                                        onclick="removeRow(this)">
                            </ejs-button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <ejs-button id="btnAddGradeRow"
                    content="Add Row"
                    iconCss="fas fa-plus"
                    cssClass="e-success e-plus mb-3"
                    iconPosition="Left"
                    onclick="addRow()">
        </ejs-button>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <ejs-button id="btnSaveGrades"
                        type="submit"
                        content="Save Grades"
                        iconCss="fas fa-save"
                        cssClass="e-primary e-plus">
            </ejs-button>

            <ejs-button id="btnBackGrades"
                        content="Back"
                        iconCss="fas fa-arrow-left"
                        cssClass="e-secondary e-plus"
                        onclick="location.href='/EmployeeDashboard/Grades'">
            </ejs-button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const subjectOptions = `@Html.Raw(GetSubjectOptions(0))`;
        const gradeTypeOptions = `@Html.Raw(GetGradeTypeOptions(0))`;

        function addRow() {
            const tbody = document.querySelector('#gradesTable tbody');
            const index = tbody.querySelectorAll('tr').length;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="Grades[${index}].SubjectId" class="form-select" required>
                        <option value="">-- Select Subject --</option>
                        ${subjectOptions}
                    </select>
                </td>
                <td>
                    <select name="Grades[${index}].GradeTypeId" class="form-select" required>
                        <option value="">-- Select Grade Type --</option>
                        ${gradeTypeOptions}
                    </select>
                </td>
                <td>
                    <input name="Grades[${index}].Grade" class="form-control" type="number" step="0.01" min="0" max="20" />
                </td>
                <td id="removeBtnCell-${index}" class="text-center">
                    <div id="removeBtnWrapper-${index}" class="justify-content-center align-items-center"></div>
                </td>
            `;
            tbody.appendChild(tr);

            const removeBtn = new ej.buttons.Button({
                iconCss: 'fas fa-minus',
                cssClass: 'e-danger e-plus',
                isPrimary: false,
                enableRipple: true,
                created: function () {
                    this.element.onclick = function () {
                        removeRow(this);
                    };
                }
            });

            removeBtn.appendTo(`#removeBtnWrapper-${index}`);
        }

        function removeRow(button) {
            const row = button.closest('tr');
            row.remove();

            const rows = document.querySelectorAll('#gradesTable tbody tr');
            rows.forEach((tr, i) => {
                tr.querySelectorAll('select, input').forEach(el => {
                    const name = el.getAttribute('name');
                    if (name) {
                        const newName = name.replace(/\d+/, i);
                        el.setAttribute('name', newName);
                    }
                });

                const btnCell = tr.querySelector('td[id^="removeBtnCell-"]');
                const wrapper = tr.querySelector('div[id^="removeBtnWrapper-"]');
                if (btnCell) btnCell.id = `removeBtnCell-${i}`;
                if (wrapper) wrapper.id = `removeBtnWrapper-${i}`;
            });
        }
    </script>
}
