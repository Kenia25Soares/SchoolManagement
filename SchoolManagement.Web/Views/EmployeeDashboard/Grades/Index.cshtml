@model StudentGradesIndexViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students Grades Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage student grades here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm position-relative" style="border-top: 2px solid @(Model.IsClassClosed ? "#0d6efd" : "#dee2e6")">
                @if (Model.IsClassClosed)
                {
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2">
                        Class Closed
                    </span>
                }

                <div class="card-body">
                    <h5 class="card-title">Students Grades</h5>

                    <!-- Class Filter + Close Button -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <form method="get" asp-action="Index" class="d-inline">
                            <select name="classId" class="form-select d-inline w-auto" onchange="this.form.submit()">
                                @foreach (var cls in Model.Classes)
                                {
                                    <option value="@cls.Value" selected="@(cls.Selected ? "selected" : null)">
                                        @cls.Text
                                    </option>
                                }
                            </select>
                        </form>

                        @if (!Model.IsClassClosed && Model.Classes.Any(c => c.Selected))
                        {
                            var selectedClassId = Model.Classes.First(c => c.Selected).Value;
                            <button type="button" class="btn btn-danger" onclick="showCloseModal('@selectedClassId')">
                                Close Class (End Year)
                            </button>
                        }
                    </div>

                    <!-- Students Table -->
                    <table class="table table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Average Grade</th>
                                <th>Absences</th>
                                <th style="width: 30%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.FullName</td>
                                    <td>@student.Email</td>
                                    <td>
                                        @(student.AverageGrade.HasValue ? student.AverageGrade.Value.ToString("F2") : "-")
                                    </td>
                                    <td>
                                        @if (student.FailedDueToAbsences)
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Good Standing</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <ejs-button id="btnAddGrades-@student.Id"
                                                        content="Grades"
                                                        iconCss="fas fa-plus"
                                                        cssClass="e-primary e-plus"
                                                        disabled="@(Model.IsClassClosed)"
                                                        onclick="location.href='/EmployeeDashboard/Grades/AddGrades?studentId=@student.Id'">
                                            </ejs-button>

                                            <ejs-button id="btnViewGrades-@student.Id"
                                                        content="View"
                                                        iconCss="fas fa-eye"
                                                        cssClass="e-info e-plus"
                                                        onclick="location.href='/EmployeeDashboard/Grades/Details?studentId=@student.Id'">
                                            </ejs-button>

                                            <ejs-button id="btnAddAbsences-@student.Id"
                                                        content="Absences"
                                                        iconCss="fas fa-user-clock"
                                                        cssClass="e-warning e-plus"
                                                        disabled="@(Model.IsClassClosed)"
                                                        onclick="location.href='/EmployeeDashboard/Grades/AddAbsences?studentId=@student.Id'">
                                            </ejs-button>

                                            <ejs-button id="btnViewAbsences-@student.Id"
                                                        content="View Absences"
                                                        iconCss="fas fa-eye"
                                                        cssClass="e-warning e-plus"
                                                        onclick="location.href='/EmployeeDashboard/Grades/ViewAbsences?studentId=@student.Id'">
                                            </ejs-button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Close Class Confirmation Modal -->
@if (!Model.IsClassClosed && Model.Classes.Any(c => c.Selected))
{
    <div class="modal fade" id="closeClassModal" tabindex="-1" aria-labelledby="closeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="closeModalLabel">Confirm Close Class</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to close this class?</p>
                    <p><strong>This action cannot be undone.</strong></p>
                </div>
                <div class="modal-footer">
                    <form id="closeClassForm" method="post" asp-action="CloseClass">
                        <input type="hidden" name="classId" id="classIdToClose" />

                        <ejs-button id="confirmCloseBtn"
                                    type="submit"
                                    content="Close"
                                    iconCss="fas fa-lock"
                                    cssClass="e-danger">
                        </ejs-button>

                        <ejs-button id="cancelCloseBtn"
                                    content="Cancel"
                                    iconCss="fas fa-times"
                                    cssClass="e-secondary"
                                    onclick="bootstrap.Modal.getInstance(document.getElementById('closeClassModal')).hide(); return false;">
                        </ejs-button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function showCloseModal(classId) {
        document.getElementById('classIdToClose').value = classId;
        var modal = new bootstrap.Modal(document.getElementById('closeClassModal'));
        modal.show();
    }
</script>
