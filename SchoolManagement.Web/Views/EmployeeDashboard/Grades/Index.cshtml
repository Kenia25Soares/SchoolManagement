@model StudentGradesIndexViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students Grades Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage student grades here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Students Grades</h5>

                    <form method="get" asp-action="Index" class="mb-3">
                        <select name="classId" class="form-select w-auto d-inline" onchange="this.form.submit()">
                            @foreach (var cls in Model.Classes)
                            {
                                <option value="@cls.Value" selected="@(cls.Selected ? "selected" : null)">
                                    @cls.Text
                                </option>
                            }
                        </select>
                    </form>

                    <table class="table table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Average Grade</th>
                                <th>Absences</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                <td>@student.FullName</td>
                                <td>@student.Email</td>
                                <td>
                                    @(student.AverageGrade.HasValue? student.AverageGrade.Value.ToString("F2") : "-")
                                </td>
                                <td>
                                    @if (student.FailedDueToAbsences)
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Good Standing</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group" aria-label="Student actions">
                                            <a asp-action="AddGrades" asp-route-studentId="@student.Id"
                                               class="btn btn-primary btn-sm me-2" title="Add Grades">
                                                Grades
                                            </a>
                                            <a asp-action="Details" asp-route-studentId="@student.Id"
                                               class="btn btn-info btn-sm me-2" title="View Grades">
                                                View Grades
                                            </a>
                                            <a asp-action="AddAbsences" asp-route-studentId="@student.Id"
                                               class="btn btn-warning btn-sm me-2" title="Add Absences">
                                                Absences
                                            </a>
                                            <a asp-action="ViewAbsences" asp-route-studentId="@student.Id"
                                               class="btn btn-warning btn-sm me-2" title="View Absences">
                                                View Absences
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

