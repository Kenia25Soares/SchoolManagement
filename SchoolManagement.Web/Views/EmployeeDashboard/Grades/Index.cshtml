@model StudentGradesIndexViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students Grades Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage student grades here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm position-relative" style="border-top: 2px solid @(Model.IsClassClosed ? "#0d6efd" : "#dee2e6")">
                @if (Model.IsClassClosed)
                {
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2">
                        Class Closed
                    </span>
                }

                <div class="card-body">
                    <h5 class="card-title">Students Grades</h5>

                    <!-- Class Filter + Close Button -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <form method="get" asp-action="Index" class="d-inline">
                            <select name="classId" class="form-select d-inline w-auto" onchange="this.form.submit()">
                                @foreach (var cls in Model.Classes)
                                {
                                    <option value="@cls.Value" selected="@(cls.Selected ? "selected" : null)">
                                        @cls.Text
                                    </option>
                                }
                            </select>
                        </form>

                        @if (!Model.IsClassClosed && Model.Classes.Any(c => c.Selected))
                        {
                            var selectedClassId = Model.Classes.First(c => c.Selected).Value;
                            <ejs-button id="btnCloseClass"
                                        content="Close Class (End Year)"
                                        iconCss="fas fa-lock"
                                        cssClass="e-danger e-small"
                                        iconPosition="Left"
                                        onclick="showCloseModal('@selectedClassId')">
                            </ejs-button>
                        }
                    </div>

                    <!-- Students Grades Grid -->
                    <div id="GradesGrid"></div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Close Class Confirmation Modal -->
@if (!Model.IsClassClosed && Model.Classes.Any(c => c.Selected))
{
    <div class="modal fade" id="closeClassModal" tabindex="-1" aria-labelledby="closeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="closeModalLabel">Confirm Close Class</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to close this class?</p>
                    <p><strong>This action cannot be undone.</strong></p>
                </div>
                <div class="modal-footer">
                    <form id="closeClassForm" method="post" asp-action="CloseClass">
                        <input type="hidden" name="classId" id="classIdToClose" />

                        <ejs-button id="confirmCloseBtn"
                                    type="submit"
                                    content="Close"
                                    iconCss="fas fa-lock"
                                    cssClass="e-danger">
                        </ejs-button>

                        <ejs-button id="cancelCloseBtn"
                                    content="Cancel"
                                    iconCss="fas fa-times"
                                    cssClass="e-secondary"
                                    onclick="bootstrap.Modal.getInstance(document.getElementById('closeClassModal')).hide(); return false;">
                        </ejs-button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var isClassClosed = @Model.IsClassClosed.ToString().ToLower();
        var students = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Students));

        var grid = new ej.grids.Grid({
            dataSource: students,
            allowPaging: true,
            allowSorting: true,
            allowFiltering: true,
            filterSettings: { type: 'CheckBox' },
            pageSettings: { pageSize: 10 },
            height: "auto",
            columns: [
                { field: 'FullName', headerText: 'Name', width: 180 },
                { field: 'Email', headerText: 'Email', width: 200 },
                {
                    field: 'AverageGrade',
                    headerText: 'Average Grade',
                    width: 150,
                    textAlign: 'Right',
                    template: function (data) {
                        if (data.AverageGrade === null) return '-';
                        const grade = data.AverageGrade.toFixed(2);
                        const color = data.AverageGrade < 10 ? 'red' : 'inherit';
                        return `<span style="color:${color}; font-weight:bold;">${grade}</span>`;
                    }
                },
                {
                    headerText: 'Actions',
                    width: 350,
                    textAlign: 'Center',
                    template: function (data) {
                        return `
                            <button class="e-btn e-primary me-1" ${isClassClosed ? 'disabled' : ''} onclick="location.href='/EmployeeDashboard/Grades/AddGrades?studentId=${data.Id}'">
                                <i class="fas fa-plus"></i> Grades
                            </button>
                            <button class="e-btn e-info me-1" onclick="location.href='/EmployeeDashboard/Grades/Details?studentId=${data.Id}'">
                                <i class="fas fa-eye"></i> View
                            </button>
                            <button class="e-btn e-warning me-1" ${isClassClosed ? 'disabled' : ''} onclick="location.href='/EmployeeDashboard/Grades/AddAbsences?studentId=${data.Id}'">
                                <i class="fas fa-user-clock"></i> Absences
                            </button>
                            <button class="e-btn e-warning" onclick="location.href='/EmployeeDashboard/Grades/ViewAbsences?studentId=${data.Id}'">
                                <i class="fas fa-eye"></i> View Absences
                            </button>
                        `;
                    }
                }
            ]
        });

        grid.appendTo('#GradesGrid');

        function showCloseModal(classId) {
            document.getElementById('classIdToClose').value = classId;
            var modal = new bootstrap.Modal(document.getElementById('closeClassModal'));
            modal.show();
        }
    </script>
}
