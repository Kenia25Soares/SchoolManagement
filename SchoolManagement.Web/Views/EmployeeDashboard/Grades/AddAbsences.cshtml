@model AddAbsencesViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Absences for Student";

    string GetSubjectOptions(int selectedId)
    {
        var options = "";
        foreach (var s in Model.Subjects)
        {
            var selected = s.Value == selectedId.ToString() ? "selected" : "";
            options += $"<option value='{s.Value}' {selected}>{s.Text}</option>";
        }
        return options;
    }
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Add absences for <strong>@ViewBag.StudentName</strong> here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Add Absences for @ViewBag.StudentName</h5>

                    <form asp-action="AddAbsences" method="post">
                        <input type="hidden" asp-for="StudentId" />

                        <table class="table table-bordered" id="absencesTable">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Absences</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Absences.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <select name="Absences[@i].SubjectId" class="form-select" required>
                                                <option value="">-- Select Subject --</option>
                                                @Html.Raw(GetSubjectOptions(Model.Absences[i].SubjectId))
                                            </select>
                                        </td>
                                        <td>
                                            <input name="Absences[@i].Absences" class="form-control" type="number" min="0" value="@Model.Absences[i].Absences" required />
                                        </td>
                                        <td id="removeBtnCell-@i" class="d-flex justify-content-center align-items-center py-2">
                                            <ejs-button id="btnRemoveRow-@i"
                                                        type="button"
                                                        iconCss="fas fa-minus"
                                                        cssClass="e-danger e-plus"
                                                        onclick="removeRow(this)">
                                            </ejs-button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <ejs-button id="btnAddRow"
                                    content="Add Row"
                                    iconCss="fas fa-plus"
                                    cssClass="e-success e-plus mb-3"
                                    iconPosition="Left"
                                    onclick="addRow()">
                        </ejs-button>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <ejs-button id="btnSaveAbsences"
                                        type="submit"
                                        content="Save Absences"
                                        iconCss="fas fa-save"
                                        cssClass="e-primary e-plus">
                            </ejs-button>

                            <ejs-button id="btnBackToDashboard"
                                        content="Back"
                                        iconCss="fas fa-arrow-left"
                                        cssClass="e-secondary e-plus"
                                        onclick="location.href='/EmployeeDashboard/Grades'">
                            </ejs-button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const subjectOptions = `@Html.Raw(GetSubjectOptions(0))`;

        function addRow() {
            const tbody = document.querySelector('#absencesTable tbody');
            const index = tbody.querySelectorAll('tr').length;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="Absences[${index}].SubjectId" class="form-select" required>
                        <option value="">-- Select Subject --</option>
                        ${subjectOptions}
                    </select>
                </td>
                <td>
                    <input name="Absences[${index}].Absences" class="form-control" type="number" min="0" required />
                </td>
                <td id="removeBtnCell-${index}" class="text-center">
                    <div id="removeBtnWrapper-${index}" class="justify-content-center align-items-center"></div>
                </td>
            `;
            tbody.appendChild(tr);

            const removeBtn = new ej.buttons.Button({
                iconCss: 'fas fa-minus',
                cssClass: 'e-danger e-plus',
                isPrimary: false,
                enableRipple: true,
                created: function () {
                    this.element.onclick = function () {
                        removeRow(this);
                    };
                }
            });

            removeBtn.appendTo(`#removeBtnWrapper-${index}`);
        }

        function removeRow(button) {
            const row = button.closest('tr');
            row.remove();

            const rows = document.querySelectorAll('#absencesTable tbody tr');
            rows.forEach((tr, i) => {
                tr.querySelectorAll('select, input').forEach(el => {
                    const name = el.getAttribute('name');
                    if (name) {
                        const newName = name.replace(/\d+/, i);
                        el.setAttribute('name', newName);
                    }
                });

                const btnCell = tr.querySelector('td[id^="removeBtnCell-"]');
                if (btnCell) btnCell.id = `removeBtnCell-${i}`;
            });
        }
    </script>
}
