@model SchoolManagement.Web.Models.EditStudentProfileViewModel

@{
    ViewData["Title"] = "Edit Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 900px;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Edit Student</h2>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="off" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Current Official Photo:</label>
                        <div class="mb-2">
                            <img src="@(string.IsNullOrEmpty(Model.OfficialPhotoUrl)
                                                  ? "/images/default-official-photo.png"
                                                  : $"https://blobainek.blob.core.windows.net/projetspictures/{Model.OfficialPhotoUrl}")"
                                 alt="Official Photo"
                                 class="rounded"
                                 style="width: 150px; height: 150px; object-fit: cover;"
                                 onerror="this.onerror=null; this.replaceWith(document.createTextNode('No Image'));" />
                        </div>
                        <label asp-for="OfficialPhoto" class="form-label">Upload New Official Photo</label>
                        <input asp-for="OfficialPhoto" type="file" class="form-control" />
                        <span asp-validation-for="OfficialPhoto" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Current Profile Picture:</label>
                        <div class="mb-2">
                            <img src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl)
                                                  ? "/images/default-profile.png"
                                                  : $"https://blobainek.blob.core.windows.net/projetspictures/{Model.ProfilePictureUrl}")"
                                 alt="Profile Picture"
                                 class="rounded-circle"
                                 style="width: 150px; height: 150px; object-fit: cover;"
                                 onerror="this.onerror=null; this.replaceWith(document.createTextNode('No Image'));" />
                        </div>
                        <label asp-for="ProfilePicture" class="form-label">Upload New Profile Picture</label>
                        <input asp-for="ProfilePicture" type="file" class="form-control" />
                        <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StudentClassId" class="form-label">Class</label>
                        <select asp-for="StudentClassId" class="form-select" asp-items="ViewBag.Classes">
                            <option value="">-- Select Class --</option>
                        </select>
                        <span asp-validation-for="StudentClassId" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <ejs-button id="btnEditStudent"
                                type="submit"
                                content="Save Changes"
                                iconCss="fas fa-save"
                                cssClass="e-success e-plus"
                                iconPosition="Left">
                    </ejs-button>

                    <ejs-button id="btnBackToStudents"
                                type="button"
                                content="Back"
                                iconCss="fas fa-arrow-left"
                                cssClass="e-secondary e-plus"
                                iconPosition="Left"
                                onclick="location.href='/EmployeeDashboard/Students'">
                    </ejs-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
