@model IEnumerable<SchoolManagement.Web.Models.UserListViewModel>

@{
    ViewData["Title"] = "Students Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Students Management</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">Add New Student</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Profile</th>
                <th>Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(student.ProfilePictureUrl)
                                                         ? "/images/default-profile.png"
                                                         : $"https://blobainek.blob.core.windows.net/projetspictures/{student.ProfilePictureUrl}")"
                         class="rounded-circle"
                         style="width: 40px; height: 40px; object-fit: cover;" />
                </td>
                <td>@student.FullName</td>
                <td>@student.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>
