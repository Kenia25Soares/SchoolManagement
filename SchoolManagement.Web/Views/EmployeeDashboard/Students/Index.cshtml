@model IEnumerable<SchoolManagement.Web.Models.UserListViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage students here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>

                    <ejs-button id="btnAddStudent"
                                cssClass="e-success mb-3 e-plus"
                                content="Add New Student"
                                iconCss="fas fa-user-plus"
                                iconPosition="Left"
                                onclick="location.href='/EmployeeDashboard/Students/Create'">
                    </ejs-button>

                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Profile</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(student.ProfilePictureUrl)
                                                                                                         ? "/images/default-profile.png"
                                                                                                         : $"https://blobainek.blob.core.windows.net/projetspictures/{student.ProfilePictureUrl}")"
                                         class="rounded-circle"
                                         style="width: 40px; height: 40px; object-fit: cover;" />
                                </td>
                                <td>@student.FullName</td>
                                <td>@student.Email</td>
                                <td>
                                    <ejs-button id="btnEdit-@student.Id"
                                                content="Edit"
                                                iconCss="fas fa-pen"
                                                cssClass="e-warning e-plus me-1"
                                                onclick="location.href='/EmployeeDashboard/Students/Edit/@student.Id'">
                                    </ejs-button>

                                        <ejs-button id="btnDetails-@student.Id"
                                                    content="Details"
                                                    iconCss="fas fa-eye"
                                                    cssClass="e-primary e-plus me-1"
                                                    onclick="location.href='/EmployeeDashboard/Students/Details/@student.Id'">
                                        </ejs-button>

                                        <ejs-button id="btnDelete-@student.Id"
                                                    content="Delete"
                                                    iconCss="fas fa-trash"
                                                    cssClass="e-danger e-plus"
                                                    data-id="@student.Id"
                                                    data-name="@student.FullName"
                                                    onclick="showDeleteModal(this)">
                                        </ejs-button>
                                    </td>
                                </tr>
                                                        }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the student:</p>
                <h6 id="studentName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="studentIdToDelete" />

                    <ejs-button id="confirmDeleteBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteBtn"
                                type="button"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function showDeleteModal(button) {
            var studentId = button.getAttribute('data-id');
            var studentName = button.getAttribute('data-name');

            document.getElementById('studentName').innerText = studentName;
            document.getElementById('studentIdToDelete').value = studentId;
            document.getElementById('deleteForm').action = '/EmployeeDashboard/Students/Delete/' + studentId;

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
