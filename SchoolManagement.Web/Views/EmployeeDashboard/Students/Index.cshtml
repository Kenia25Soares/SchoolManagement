@model IEnumerable<SchoolManagement.Web.Models.UserListViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage students here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>
                    <a asp-action="Create" class="btn btn-success mb-3">Add New Student</a>

                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Profile</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(student.ProfilePictureUrl)
                                                                                         ? "/images/default-profile.png"
                                                                                         : $"https://blobainek.blob.core.windows.net/projetspictures/{student.ProfilePictureUrl}")"
                                         class="rounded-circle"
                                         style="width: 40px; height: 40px; object-fit: cover;" />
                                </td>
                                <td>@student.FullName</td>
                                <td>@student.Email</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning">Edit</a>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-id="@student.Id"
                                            data-name="@student.FullName"
                                            aria-label="Delete student @student.FullName">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                                                        }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the student:</p>
                <h6 id="studentName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="studentIdToDelete" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var studentId = button.getAttribute('data-id');
            var studentName = button.getAttribute('data-name');

            document.getElementById('studentName').innerText = studentName;
            document.getElementById('studentIdToDelete').value = studentId;

            // Ajuste a action do form conforme sua rota para deletar estudante
            document.getElementById('deleteForm').action = '/EmployeeDashboard/Students/Delete/' + studentId;
        });
    </script>
}
