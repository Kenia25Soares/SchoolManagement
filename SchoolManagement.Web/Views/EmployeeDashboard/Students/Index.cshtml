@model IEnumerable<SchoolManagement.Web.Models.UserListViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Students Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage students here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>

                    <ejs-button id="btnAddStudent"
                                cssClass="e-success mb-3 e-plus"
                                content="Add New Student"
                                iconCss="fas fa-user-plus"
                                iconPosition="Left"
                                onclick="location.href='/EmployeeDashboard/Students/Create'">
                    </ejs-button>

                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the student:</p>
                <h6 id="studentName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="studentIdToDelete" />

                    <ejs-button id="confirmDeleteBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteBtn"
                                type="button"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var students = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        var grid = new ej.grids.Grid({
            dataSource: students,
            allowPaging: true,
            allowSorting: true,
            allowFiltering: true,
            filterSettings: { type: 'CheckBox' },
            pageSettings: { pageSize: 10 },
            columns: [
                {
                    headerText: 'Profile',
                    template: function (data) {
                        const imageUrl = data.ProfilePictureUrl
                            ? `https://blobainek.blob.core.windows.net/projetspictures/${data.ProfilePictureUrl}`
                            : '/images/default-profile.png';
                        return `<img src="${imageUrl}" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;" />`;
                    },
                    width: 100,
                    textAlign: 'Center'
                },
                { field: 'FullName', headerText: 'Name', width: 150 },
                { field: 'Email', headerText: 'Email', width: 200 },
                { field: 'ClassName', headerText: 'Class', width: 120 },
                {
                    field: 'AverageGrade',
                    headerText: 'Avg. Grade',
                    width: 120,
                    textAlign: 'Right',
                    template: function (data) {
                        const grade = data.AverageGrade !== null ? data.AverageGrade.toFixed(2) : '—';
                        const color = data.AverageGrade !== null && data.AverageGrade < 10 ? 'red' : 'inherit';
                        return `<span style="color:${color}; font-weight:bold;">${grade}</span>`;
                    }
                },
                {
                    headerText: 'Actions',
                    template: function(data) {
                        return `
                            <button class="e-btn e-warning me-1" onclick="location.href='/EmployeeDashboard/Students/Edit/${data.Id}'">
                                <i class="fas fa-pen"></i> Edit
                            </button>
                            <button class="e-btn e-primary me-1" onclick="location.href='/EmployeeDashboard/Students/Details/${data.Id}'">
                                <i class="fas fa-eye"></i> Details
                            </button>
                            <button class="e-btn e-danger" onclick="showDeleteModalById('${data.Id}', '${data.FullName}')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        `;
                    },
                    width: 230,
                    textAlign: 'Center'
                }
            ]
        });

        grid.appendTo('#Grid');

        function showDeleteModalById(id, name) {
            document.getElementById('studentName').innerText = name;
            document.getElementById('studentIdToDelete').value = id;
            document.getElementById('deleteForm').action = '/EmployeeDashboard/Students/Delete/' + id;

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
