@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Welcome to the control panel.</p>

    <div class="row mt-4">
        <!-- Card: Manage Students -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>
                    <p class="card-text">Manage students enrollment.</p>
                    <a href="/EmployeeDashboard/Students" class="btn btn-primary">Manage Students</a>
                </div>
            </div>
        </div>

        <!-- Card: Manage Student Classes -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Student Classes</h5>
                    <p class="card-text">Create and manage classes.</p>
                    <a href="/EmployeeDashboard/StudentClasses" class="btn btn-primary">Manage Classes</a>
                </div>
            </div>
        </div>

        <!-- Card: Manage Grades -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Grades</h5>
                    <p class="card-text">Assign grades and track absences by subject.</p>
                    <a href="/EmployeeDashboard/Grades" class="btn btn-primary">Manage Grades</a>
                </div>
            </div>
        </div>
    </div>
</div>
