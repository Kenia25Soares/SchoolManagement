@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Welcome to the control panel.</p>

    <div class="row mt-4">
        <!-- Card: Manage Students -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>
                    <p class="card-text">Manage students enrollment.</p>
                    <a href="/EmployeeDashboard/Students" class="btn btn-primary">Manage Students</a>
                </div>
            </div>
        </div>

        <!-- Card: Manage Courses (NEW) -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Manage courses, assign students and subjects.</p>
                    <a href="/EmployeeDashboard/Courses" class="btn btn-primary">Manage Courses</a>
                </div>
            </div>
        </div>
    </div>
</div>
