@model EmployeeDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Welcome to the control panel.</p>

    <div class="row mt-4">
        <!-- STUDENTS -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-primary">@Model.TotalStudents</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Students</h5>
                    <p class="card-text">Manage student enrollment.</p>
                    <ejs-button id="ManageStudents"
                                content="Manage Students"
                                iconCss="fas fa-user-graduate"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/EmployeeDashboard/Students'">
                    </ejs-button>
                </div>
            </div>
        </div>

        <!-- STUDENT CLASSES -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2 d-flex gap-1">
                    <span class="badge bg-success" title="Open">@Model.OpenClasses</span>
                    <span class="badge bg-danger" title="Closed">@Model.ClosedClasses</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Student Classes</h5>
                    <p class="card-text">Create and manage student classes.</p>
                    <ejs-button id="ManageStudentClasses"
                                content="Manage Classes"
                                iconCss="fas fa-chalkboard-teacher"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/EmployeeDashboard/StudentClasses'">
                    </ejs-button>
                </div>
            </div>
        </div>

        <!-- GRADES -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Grades</h5>
                    <p class="card-text">Assign grades and track absences by subject.</p>
                    <ejs-button id="ManageGrades"
                                content="Manage Grades"
                                iconCss="fas fa-book-open"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/EmployeeDashboard/Grades'">
                    </ejs-button>
                </div>
            </div>
        </div>
    </div>
</div>
