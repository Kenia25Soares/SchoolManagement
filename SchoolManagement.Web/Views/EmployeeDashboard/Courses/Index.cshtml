@model IEnumerable<SchoolManagement.Web.Data.Entities.Course>

@{
    ViewData["Title"] = "Courses Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Courses Management</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">Add New Course</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th style="width: 10%;">Course number</th>
                <th>Course Name</th>
                <th style="width: 10%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Id</td>
                    <td>@course.Name</td>
                    <td>
                        <a asp-action="Manage" asp-route-id="@course.Id" class="btn btn-sm btn-primary">Manage</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
