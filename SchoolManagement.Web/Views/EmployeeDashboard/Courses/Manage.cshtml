@model SchoolManagement.Web.Models.CourseManagementViewModel

@{
    ViewData["Title"] = "Manage Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 1000px;">
        <div class="card-body">

            <h2 class="card-title text-center mb-4">
                Manage Course: @Model.CourseName
            </h2>

            <input type="hidden" id="courseId" value="@Model.CourseId" />

            <h5 class="text-primary mb-2">Subjects</h5>
            <div class="row mb-4">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Available</label>
                    <select id="availableSubjects" class="form-control" multiple size="6">
                        @foreach (var s in Model.AvailableSubjects)
                        {
                            <option value="@s.SubjectId">@s.SubjectName</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex flex-column justify-content-center align-items-center gap-2">
                    <button type="button" class="btn btn-success w-100" onclick="assignSubjects()">➕</button>
                    <button type="button" class="btn btn-danger  w-100" onclick="removeSubjects()">➖</button>
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold">Assigned</label>
                    <select id="assignedSubjects" class="form-control" multiple size="6">
                        @foreach (var s in Model.AssignedSubjects)
                        {
                            <option value="@s.SubjectId">@s.SubjectName</option>
                        }
                    </select>
                </div>
            </div>

            <h5 class="text-primary mb-2">Students</h5>
            <div class="row">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Available</label>
                    <select id="availableStudents" class="form-control" multiple size="8">
                        @foreach (var st in Model.AvailableStudents)
                        {
                            <option value="@st.StudentId">@st.StudentName</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex flex-column justify-content-center align-items-center gap-2">
                    <button type="button" class="btn btn-success w-100" onclick="assignStudents()">➕</button>
                    <button type="button" class="btn btn-danger  w-100" onclick="removeStudents()">➖</button>
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold">Assigned</label>
                    <select id="assignedStudents" class="form-control" multiple size="8">
                        @foreach (var st in Model.AssignedStudents)
                        {
                            <option value="@st.StudentId">@st.StudentName</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function moveItems(fromId, toId) {
            const from = document.getElementById(fromId);
            const to   = document.getElementById(toId);
            Array.from(from.selectedOptions).forEach(opt => { from.removeChild(opt); to.appendChild(opt); });
        }

        function assignSubjects() {
            const courseId = document.getElementById("courseId").value;
            const from = document.getElementById("availableSubjects");
            const to   = document.getElementById("assignedSubjects");

            Array.from(from.selectedOptions).forEach(opt => {
                fetch('/EmployeeDashboard/Courses/AssignSubject', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `courseId=${courseId}&subjectId=${opt.value}`
                }).then(r => { if (r.ok) moveItems('availableSubjects','assignedSubjects'); });
            });
        }
        function removeSubjects() {
            const courseId = document.getElementById("courseId").value;
            Array.from(document.getElementById("assignedSubjects").selectedOptions).forEach(opt => {
                fetch('/EmployeeDashboard/Courses/RemoveSubject', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `courseId=${courseId}&subjectId=${opt.value}`
                }).then(r => { if (r.ok) moveItems('assignedSubjects','availableSubjects'); });
            });
        }

        function assignStudents() {
            const courseId = document.getElementById("courseId").value;
            Array.from(document.getElementById("availableStudents").selectedOptions).forEach(opt => {
                fetch('/EmployeeDashboard/Courses/AssignStudent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `courseId=${courseId}&studentId=${opt.value}`
                }).then(r => { if (r.ok) moveItems('availableStudents','assignedStudents'); });
            });
        }
        function removeStudents() {
            const courseId = document.getElementById("courseId").value;
            Array.from(document.getElementById("assignedStudents").selectedOptions).forEach(opt => {
                fetch('/EmployeeDashboard/Courses/RemoveStudent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `courseId=${courseId}&studentId=${opt.value}`
                }).then(r => { if (r.ok) moveItems('assignedStudents','availableStudents'); });
            });
        }
    </script>
}
