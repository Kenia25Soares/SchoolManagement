@model IEnumerable<SchoolManagement.Web.Models.StudentClassViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student Classes";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage student classes here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Student Classes</h5>

                    <ejs-button id="btnAddClass"
                                content="Add New Class"
                                iconCss="fas fa-plus"
                                cssClass="e-success mb-3"
                                iconPosition="Left"
                                onclick="location.href='/EmployeeDashboard/StudentClasses/Create'">
                    </ejs-button>

                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Academic Year</th>
                                <th>Shift</th>
                                <th>Course</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sc in Model)
                            {
                                <tr>
                                    <td>@sc.Name</td>
                                    <td>@sc.AcademicYear</td>
                                    <td>@sc.Shift</td>
                                    <td>@sc.CourseName</td>
                                    <td>
                                        <ejs-button id="btnEdit-@sc.Id"
                                                    content="Edit"
                                                    iconCss="fas fa-pen"
                                                    cssClass="e-warning e-plus me-1"
                                                    onclick="location.href='/EmployeeDashboard/StudentClasses/Edit/@sc.Id'">
                                        </ejs-button>

                                        <ejs-button id="btnManage-@sc.Id"
                                                    content="Manage"
                                                    iconCss="fas fa-cogs"
                                                    cssClass="e-primary e-plus me-1"
                                                    onclick="location.href='/EmployeeDashboard/StudentClasses/Manage/@sc.Id'">
                                        </ejs-button>

                                        <ejs-button id="btnDelete-@sc.Id"
                                                    content="Delete"
                                                    iconCss="fas fa-trash"
                                                    cssClass="e-danger e-plus"
                                                    data-id="@sc.Id"
                                                    data-name="@sc.Name">
                                        </ejs-button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the class:</p>
                <h6 id="className"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="classIdToDelete" />

                    <ejs-button id="confirmDeleteClassBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteClassBtn"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll("[id^='btnDelete-']").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const id = btn.getAttribute("data-id");
                    const name = btn.getAttribute("data-name");

                    document.getElementById('className').innerText = name;
                    document.getElementById('classIdToDelete').value = id;
                    document.getElementById('deleteForm').action = `/EmployeeDashboard/StudentClasses/Delete/${id}`;

                    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                    modal.show();
                });
            });
        });
    </script>
}
