@model IEnumerable<SchoolManagement.Web.Models.StudentClassViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student Classes";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage student classes here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Student Classes</h5>
                    <a asp-action="Create" class="btn btn-success mb-3">Add New Class</a>

                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Academic Year</th>
                                <th>Shift</th>
                                <th>Course</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sc in Model)
                            {
                                <tr>
                                    <td>@sc.Name</td>
                                    <td>@sc.AcademicYear</td>
                                    <td>@sc.Shift</td>
                                    <td>@sc.CourseName</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@sc.Id" class="btn btn-sm btn-warning">Edit</a>
                                        <a asp-action="Manage" asp-route-id="@sc.Id" class="btn btn-sm btn-primary">Manage</a>
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@sc.Id"
                                                data-name="@sc.Name"
                                                aria-label="Delete class @sc.Name">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the class:</p>
                <h6 id="className"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="classIdToDelete" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var classId = button.getAttribute('data-id');
            var className = button.getAttribute('data-name');

            document.getElementById('className').innerText = className;
            document.getElementById('classIdToDelete').value = classId;

            document.getElementById('deleteForm').action = '/EmployeeDashboard/StudentClasses/Delete/' + classId;
        });
    </script>
}
