@model IEnumerable<SchoolManagement.Web.Models.StudentClassViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student Classes Management";
}

<div class="container-fluid">
    <h1 class="mt-4">Employee Dashboard</h1>
    <p>Manage student classes here.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Student Classes</h5>

                    <ejs-button id="btnAddClass"
                                cssClass="e-success mb-3 e-plus"
                                content="Add New Class"
                                iconCss="fas fa-plus"
                                iconPosition="Left"
                                onclick="location.href='/EmployeeDashboard/StudentClasses/Create'">
                    </ejs-button>

                    <div id="StudentClassGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the class:</p>
                <h6 id="className"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="classIdToDelete" />

                    <ejs-button id="confirmDeleteClassBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteClassBtn"
                                type="button"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var studentClasses = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        var grid = new ej.grids.Grid({
            dataSource: studentClasses,
            allowPaging: true,
            allowSorting: true,
            allowFiltering: true,
            filterSettings: { type: 'CheckBox' },
            pageSettings: { pageSize: 10 },
            height: "auto",
            columns: [
                { field: 'Name', headerText: 'Name', width: 150 },
                { field: 'AcademicYear', headerText: 'Academic Year', width: 150 },
                { field: 'Shift', headerText: 'Shift', width: 120 },
                { field: 'CourseName', headerText: 'Course', width: 180 },
                {
                    field: 'StudentCount',
                    headerText: 'Students',
                    width: 120,
                    textAlign: 'Center',
                    template: function(data) {
                        return `<span class="badge bg-primary">${data.StudentCount}</span>`;
                    }
                },
                {
                    headerText: 'Actions',
                    width: 260,
                    textAlign: 'Center',
                    template: function(data) {
                        return `
                            <button class="e-btn e-warning me-1" onclick="location.href='/EmployeeDashboard/StudentClasses/Edit/${data.Id}'">
                                <i class="fas fa-pen"></i> Edit
                            </button>
                            <button class="e-btn e-primary me-1" onclick="location.href='/EmployeeDashboard/StudentClasses/Details/${data.Id}'">
                                <i class="fas fa-eye"></i> Details
                            </button>
                            <button class="e-btn e-primary me-1" onclick="location.href='/EmployeeDashboard/StudentClasses/Manage/${data.Id}'">
                                <i class="fas fa-cogs"></i> Manage
                            </button>
                            <button class="e-btn e-danger" onclick="showDeleteModal('${data.Id}', '${data.Name}')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        `;
                    }
                }
            ]
        });

        grid.appendTo('#StudentClassGrid');

        function showDeleteModal(id, name) {
            document.getElementById('className').innerText = name;
            document.getElementById('classIdToDelete').value = id;
            document.getElementById('deleteForm').action = '/EmployeeDashboard/StudentClasses/Delete/' + id;

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
