@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <!-- Header com foto de perfil -->
    <div class="d-flex align-items-center justify-content-between mt-4 mb-4">
        <h1 class="mb-0">Admin Dashboard</h1>
    </div>

    <p>Welcome to the control panel.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Manage admins, staff, and students.</p>
                    <a href="/AdminDashboard/Users" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Add or edit available courses.</p>
                    <a href="/AdminDashboard/Courses" class="btn btn-primary">Manage Courses</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Subjects</h5>
                    <p class="card-text">Add or edit available subjects.</p>
                    <a href="/AdminDashboard/Subjects" class="btn btn-primary">Manage Subjects</a>
                </div>
            </div>
        </div>
    </div>
</div>