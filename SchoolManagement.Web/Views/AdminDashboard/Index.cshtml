@model AdminDashboardCombinedViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mt-4 mb-4">
        <h1 class="mb-0">Admin Dashboard</h1>
    </div>

    <p>Welcome to the control panel.</p>

    <!-- Cards -->
    <div class="row mt-4">
        <!-- Users -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-primary">@Model.Stats.TotalUsers</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Manage admins, staff, and students.</p>
                    <ejs-button id="ManageUsers"
                                content="Manage Users"
                                iconCss="fas fa-users"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/AdminDashboard/Users'">
                    </ejs-button>
                </div>
            </div>
        </div>

        <!-- Courses -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-success">@Model.Stats.TotalCourses</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Add or edit available courses.</p>
                    <ejs-button id="ManageCourses"
                                content="Manage Courses"
                                iconCss="fas fa-graduation-cap"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/AdminDashboard/Courses'">
                    </ejs-button>
                </div>
            </div>
        </div>

        <!-- Subjects -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-warning text-dark">@Model.Stats.TotalSubjects</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Subjects</h5>
                    <p class="card-text">Add or edit available subjects.</p>
                    <ejs-button id="ManageSubjects"
                                content="Manage Subjects"
                                iconCss="fas fa-book"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/AdminDashboard/Subjects'">
                    </ejs-button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Grid -->
    <div class="alerts-title">System Alerts</div>

    @if (!Model.Alerts.Any())
    {
        <div class="alert alert-info text-center">No alerts found.</div>
    }
    else
    {
        <div id="AlertsGrid"></div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var alerts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Alerts));

        var grid = new ej.grids.Grid({
            dataSource: alerts,
            allowPaging: true,
            allowSorting: true,
            allowFiltering: true,
            filterSettings: { type: 'CheckBox' },
            pageSettings: { pageSize: 10 },
            columns: [
                { field: 'Id', headerText: 'ID', width: 80, textAlign: 'Center' },
                { field: 'Title', headerText: 'Title', width: 150 },
                { field: 'Description', headerText: 'Description', width: 200 },
                {
                    field: 'Priority',
                    headerText: 'Priority',
                    width: 120,
                    template: function(data) {
                        const level = data.Priority;
                        if (level === 0)
                            return `<span class="badge bg-success">Low</span>`;
                        if (level === 1)
                            return `<span class="badge bg-warning text-dark">Medium</span>`;
                        if (level === 2)
                            return `<span class="badge bg-danger">High</span>`;
                        return level;
                    }
                },
                { field: 'CreatedBy', headerText: 'Created By', width: 150 },
                {
                    field: 'IsResolved',
                    headerText: 'Resolved',
                    width: 100,
                    template: function(data) {
                        return data.IsResolved
                            ? `<span class="badge bg-success">Yes</span>`
                            : `<span class="badge bg-secondary">No</span>`;
                    }
                },
                {
                    headerText: 'Actions',
                    template: function(data) {
                        if (!data.IsResolved) {
                            return `
                                <form method="post" action="/AdminAlerts/Resolve/${data.Id}">
                                    <button type="submit" class="e-btn e-primary">
                                        <i class="fas fa-check-circle"></i> Resolve
                                    </button>
                                </form>`;
                        } else {
                            return `<span class="text-muted">—</span>`;
                        }
                    },
                    width: 130,
                    textAlign: 'Center'
                }
            ]
        });

        grid.appendTo('#AlertsGrid');
    </script>
}
