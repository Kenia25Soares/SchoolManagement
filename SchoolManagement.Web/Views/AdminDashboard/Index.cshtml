@model AdminDashboardCombinedViewModel

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mt-4 mb-4">
        <h1 class="mb-0">Admin Dashboard</h1>
    </div>

    <p>Welcome to the control panel.</p>

    <!-- Cards -->
    <div class="row mt-4">
        <!-- USERS -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-primary">@Model.Stats.TotalUsers</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Manage admins, staff, and students.</p>
                    <ejs-button id="ManageUsers"
                                content="Manage Users"
                                iconCss="fas fa-users"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/AdminDashboard/Users'">
                    </ejs-button>
                </div>
            </div>
        </div>

        <!-- COURSES -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-success">@Model.Stats.TotalCourses</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Add or edit available courses.</p>
                    <ejs-button id="ManageCourses"
                                content="Manage Courses"
                                iconCss="fas fa-graduation-cap"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/AdminDashboard/Courses'">
                    </ejs-button>
                </div>
            </div>
        </div>

        <!-- SUBJECTS -->
        <div class="col-md-4 position-relative">
            <div class="card shadow-sm">
                <div class="position-absolute top-0 end-0 p-2">
                    <span class="badge bg-warning text-dark">@Model.Stats.TotalSubjects</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Subjects</h5>
                    <p class="card-text">Add or edit available subjects.</p>
                    <ejs-button id="ManageSubjects"
                                content="Manage Subjects"
                                iconCss="fas fa-book"
                                cssClass="e-primary e-plus"
                                onclick="location.href='/AdminDashboard/Subjects'">
                    </ejs-button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Table -->
    <div class="mt-5">
        <h3>System Alerts</h3>

        @if (!Model.Alerts.Any())
        {
            <div class="alert alert-info">No alerts found.</div>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Priority</th>
                        <th>Created By</th>
                        <th>Resolved</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.Alerts)
                    {
                        <tr>
                            <td>@alert.Id</td>
                            <td>@alert.Title</td>
                            <td>@alert.Description</td>
                            <td>
                                @switch (alert.Priority)
                                {
                                    case SchoolManagement.Web.Data.Enums.AlertPriority.Low:
                                        <span class="badge bg-success">Low</span>
                                        break;
                                    case SchoolManagement.Web.Data.Enums.AlertPriority.Medium:
                                        <span class="badge bg-warning text-dark">Medium</span>
                                        break;
                                    case SchoolManagement.Web.Data.Enums.AlertPriority.High:
                                        <span class="badge bg-danger">High</span>
                                        break;
                                }
                            </td>
                            <td>@alert.CreatedBy</td>
                            <td>
                                @if (alert.IsResolved)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                @if (!alert.IsResolved)
                                {
                                    <form method="post" asp-controller="AdminAlerts" asp-action="Resolve" asp-route-id="@alert.Id">
                                        <ejs-button type="submit"
                                                    content="Resolve"
                                                    iconCss="fas fa-check-circle"
                                                    cssClass="e-primary e-small">
                                        </ejs-button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
