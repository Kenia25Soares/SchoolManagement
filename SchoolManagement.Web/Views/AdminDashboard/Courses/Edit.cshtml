@model SchoolManagement.Web.Models.CourseViewModel

@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Edit Course</h2>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <ejs-button id="btnEditCourse"
                                type="submit"
                                content="Save Changes"
                                iconCss="fas fa-edit"
                                cssClass="e-success e-plus"
                                iconPosition="Left">
                    </ejs-button>

                    <ejs-button id="btnBackToCourses"
                                type="button"
                                content="Back"
                                iconCss="fas fa-arrow-left"
                                cssClass="e-secondary e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Courses'">
                    </ejs-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
