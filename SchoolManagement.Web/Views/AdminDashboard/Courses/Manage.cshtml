@model SchoolManagement.Web.Models.CourseManagementViewModel

@{
    ViewData["Title"] = "Manage Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 1000px;">
        <div class="card-body">

            <h2 class="card-title text-center mb-4">
                Manage Course: @Model.CourseName
            </h2>

            <h5 class="text-primary mb-2">Subjects</h5>
            <div class="row mb-4">
                <div class="col-md-5">
                    <label class="form-label fw-bold" for="availableSubjects">Available</label>
                    <select id="availableSubjects" class="form-control" multiple size="6" aria-label="Available Subjects">
                        @foreach (var s in Model.AvailableSubjects)
                        {
                            <option value="@s.SubjectId">@s.SubjectName</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex flex-column justify-content-center align-items-center gap-2">
                    <ejs-button id="btnAssign"
                                content="Assign"
                                iconCss="fas fa-plus"
                                cssClass="e-success e-plus w-100"
                                iconPosition="Left"
                                onclick="assignSubjects()">
                    </ejs-button>

                    <ejs-button id="btnRemove"
                                content="Remove"
                                iconCss="fas fa-minus"
                                cssClass="e-danger e-plus w-100"
                                iconPosition="Left"
                                onclick="removeSubjects()">
                    </ejs-button>
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold" for="assignedSubjects">Assigned</label>
                    <select id="assignedSubjects" class="form-control" multiple size="6" aria-label="Assigned Subjects">
                        @foreach (var s in Model.AssignedSubjects)
                        {
                            <option value="@s.SubjectId">@s.SubjectName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <ejs-button id="btnBackToCourses"
                            content="Back"
                            iconCss="fas fa-arrow-left"
                            cssClass="e-secondary e-plus"
                            iconPosition="Left"
                            onclick="location.href='/AdminDashboard/Courses'">
                </ejs-button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        const courseId = @Model.CourseId;

        function moveItems(fromId, toId) {
            const from = document.getElementById(fromId);
            const to = document.getElementById(toId);
            Array.from(from.selectedOptions).forEach(opt => {
                from.removeChild(opt);
                to.appendChild(opt);
            });
        }

        async function assignSubjects() {
            const selected = Array.from(document.getElementById('availableSubjects').selectedOptions);
            for (const opt of selected) {
                await fetch('/AdminDashboard/Courses/AssignSubject', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ courseId: courseId, subjectId: parseInt(opt.value) })
                });
            }
            moveItems('availableSubjects', 'assignedSubjects');
        }

        async function removeSubjects() {
            const selected = Array.from(document.getElementById('assignedSubjects').selectedOptions);
            for (const opt of selected) {
                await fetch('/AdminDashboard/Courses/RemoveSubject', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ courseId: courseId, subjectId: parseInt(opt.value) })
                });
            }
            moveItems('assignedSubjects', 'availableSubjects');
        }
    </script>
}
