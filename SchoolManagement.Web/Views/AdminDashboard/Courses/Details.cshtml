@model SchoolManagement.Web.Models.CourseViewModel

@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Course Details</h2>

            <form>
                <div class="mb-3">
                    <label class="form-label fw-bold">Name</label>
                    <input asp-for="Name" class="form-control" readonly />
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <ejs-button id="btnBackToCourses"
                                type="button"
                                content="Back"
                                iconCss="fas fa-arrow-left"
                                cssClass="e-secondary e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Courses'">
                    </ejs-button>

                    <ejs-button id="btnEditCourse"
                                type="button"
                                content="Edit"
                                iconCss="fas fa-pen"
                                cssClass="e-warning e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Courses/Edit/@Model.Id'">
                    </ejs-button>
                </div>
            </form>
        </div>
    </div>
</div>
