@model IEnumerable<CourseViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Courses";
}

<div class="container-fluid">
    <h1 class="mt-4">Admin Dashboard</h1>
    <p>Welcome to the management panel.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>

                    <ejs-button id="btnAddCourse"
                                content="Add Course"
                                iconCss="fas fa-plus"
                                cssClass="e-success e-plus mb-3"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Courses/Create'">
                    </ejs-button>

                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th style="width: 15%;">Subjects</th>
                                <th style="width: 30%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td>@course.Name</td>
                                    <td>
                                        <span class="badge bg-success">@course.SubjectsCount</span>
                                    </td>
                                    <td>
                                        <ejs-button id="editBtn-@course.Id"
                                                    content="Edit"
                                                    iconCss="fas fa-pen"
                                                    cssClass="e-warning e-plus me-1"
                                                    onclick="location.href='/AdminDashboard/Courses/Edit/@course.Id'">
                                        </ejs-button>

                                        <ejs-button id="detailsBtn-@course.Id"
                                                    content="Details"
                                                    iconCss="fas fa-eye"
                                                    cssClass="e-primary e-plus me-1"
                                                    onclick="location.href='/AdminDashboard/Courses/Details/@course.Id'">
                                        </ejs-button>

                                        <ejs-button id="manageBtn-@course.Id"
                                                    content="Manage"
                                                    iconCss="fas fa-cogs"
                                                    cssClass="e-info e-plus me-1"
                                                    onclick="location.href='/AdminDashboard/Courses/Manage/@course.Id'">
                                        </ejs-button>

                                        <ejs-button id="deleteBtn-@course.Id"
                                                    content="Delete"
                                                    iconCss="fas fa-trash"
                                                    cssClass="e-danger e-plus"
                                                    data-id="@course.Id"
                                                    data-name="@course.Name">
                                        </ejs-button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the course:</p>
                <h6 id="courseName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="courseIdToDelete" />

                    <ejs-button id="confirmDeleteBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteBtn"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll("[id^='deleteBtn-']").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const id = btn.getAttribute("data-id");
                    const name = btn.getAttribute("data-name");

                    document.getElementById('courseName').innerText = name;
                    document.getElementById('courseIdToDelete').value = id;
                    document.getElementById('deleteForm').action = `/AdminDashboard/Courses/Delete/${id}`;

                    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                    modal.show();
                });
            });
        });
    </script>
}
