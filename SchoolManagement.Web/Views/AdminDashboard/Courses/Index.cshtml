@model IEnumerable<CourseViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Courses";
}

<div class="container-fluid">
    <h1 class="mt-4">Admin Dashboard</h1>
    <p>Welcome to the management panel.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>

                    <ejs-button id="btnAddCourse"
                                content="Add Course"
                                iconCss="fas fa-plus"
                                cssClass="e-success e-plus mb-3"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Courses/Create'">
                    </ejs-button>

                    <div id="CoursesGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the course:</p>
                <h6 id="courseName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="courseIdToDelete" />
                    <ejs-button id="confirmDeleteBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>
                    <ejs-button id="cancelDeleteBtn"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var courses = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        var grid = new ej.grids.Grid({
            dataSource: courses,
            allowPaging: true,
            allowSorting: true,
            allowFiltering: true,
            filterSettings: { type: 'CheckBox' },
            pageSettings: { pageSize: 10 },
            columns: [
                { field: 'Name', headerText: 'Course Name', width: 200 },
                {
                    field: 'SubjectsCount',
                    headerText: 'Subjects',
                    width: 100,
                    template: "<span class='badge bg-success'>${SubjectsCount}</span>"
                },
                {
                    headerText: 'Actions',
                    width: 300,
                    template: function (data) {
                        return `
                            <button class="e-btn e-warning me-1" onclick="location.href='/AdminDashboard/Courses/Edit/${data.Id}'">
                                <i class="fas fa-pen"></i> Edit
                            </button>
                            <button class="e-btn e-primary me-1" onclick="location.href='/AdminDashboard/Courses/Details/${data.Id}'">
                                <i class="fas fa-eye"></i> Details
                            </button>
                            <button class="e-btn e-info me-1" onclick="location.href='/AdminDashboard/Courses/Manage/${data.Id}'">
                                <i class="fas fa-cogs"></i> Manage
                            </button>
                            <button class="e-btn e-danger" onclick="showDeleteModal('${data.Id}', '${data.Name}')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        `;
                    },
                    textAlign: 'Center'
                }
            ]
        });

        grid.appendTo('#CoursesGrid');

        function showDeleteModal(id, name) {
            document.getElementById('courseName').innerText = name;
            document.getElementById('courseIdToDelete').value = id;
            document.getElementById('deleteForm').action = `/AdminDashboard/Courses/Delete/${id}`;
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
