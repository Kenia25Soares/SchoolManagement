@model IEnumerable<SchoolManagement.Web.Models.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Admin Dashboard</h1>
    <p>Welcome to the management panel.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">User Management</h5>

                    <ejs-button id="btnAddUser"
                                cssClass="e-success mb-3"
                                content="Add User"
                                iconCss="e-icons e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Users/Create'">
                    </ejs-button>

                    <!-- User Table -->
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th style="width: 20%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(user.ProfilePictureUrl)
                                                                                         ? "/image/default-profile.png"
                                                                                         : $"https://blobainek.blob.core.windows.net/projetspictures/{user.ProfilePictureUrl}")"
                                         alt="Profile" class="rounded-circle me-2"
                                         style="width:40px; height:40px; object-fit:cover;" />
                                    @user.FullName
                                </td>
                                <td>@user.Email</td>
                                <td>@user.Role</td>
                                <td>
                                    <ejs-button id="btnEdit-@user.Id"  
                                                content="Edit"
                                                iconCss="e-icons e-edit"
                                                cssClass="e-warning e-plus me-1"
                                                onclick="location.href='/AdminDashboard/Users/Edit/@user.Id'">
                                    </ejs-button>

                                    <ejs-button id="btnDetails-@user.Id"  
                                                content="Details"
                                                iconCss="e-icons e-eye"
                                                cssClass="e-info e-plus me-1"
                                                onclick="location.href='/AdminDashboard/Users/Details/@user.Id'">
                                    </ejs-button>

                                    <ejs-button id="btnDelete-@user.Id"
                                                content="Delete"
                                                iconCss="e-icons e-trash"
                                                cssClass="e-danger e-plus"
                                                data-id="@user.Id"
                                                data-name="@user.FullName">
                                    </ejs-button>
                                </td>
                            </tr>
                                                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user:</p>
                <h6 id="userName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="userIdToDelete" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll("[id^='btnDelete-']").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const id = btn.getAttribute("data-id");
                    const name = btn.getAttribute("data-name");

                    document.getElementById('userName').innerText = name;
                    document.getElementById('userIdToDelete').value = id;
                    document.getElementById('deleteForm').action = `/AdminDashboard/Users/Delete/${id}`;

                    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                    modal.show();
                });
            });
        });
    </script>
}
