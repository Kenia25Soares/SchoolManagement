@model IEnumerable<SchoolManagement.Web.Models.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="mt-4">Admin Dashboard</h1>
    <p>Welcome to the management panel.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">User Management</h5>

                    <ejs-button id="btnAddUser"
                                cssClass="e-success mb-3"
                                content="Add User"
                                iconCss="fas fa-user-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Users/Create'">
                    </ejs-button>

                    <div id="UsersGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user:</p>
                <h6 id="userName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="userIdToDelete" />

                    <ejs-button id="confirmDeleteBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteBtn"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var users = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
        var currentUserId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value'; // Pega ID do user logado

        var grid = new ej.grids.Grid({
            dataSource: users,
            allowPaging: true,
            allowSorting: true,
            allowFiltering: true,
            filterSettings: { type: 'CheckBox' },
            pageSettings: { pageSize: 10 },
            columns: [
                {
                    headerText: 'Picture',
                    template: function (data) {
                        const imgUrl = data.ProfilePictureUrl
                            ? `https://blobainek.blob.core.windows.net/projetspictures/${data.ProfilePictureUrl}`
                            : '/images/default-profile.png';

                        return `<img src="${imgUrl}"
                                     alt="Profile"
                                     class="rounded-circle"
                                     style="width:40px; height:40px; object-fit:cover;"
                                     onerror="this.onerror=null; this.replaceWith(document.createTextNode('No image'));" />`;
                    },
                    width: 100,
                    textAlign: 'Center'
                },
                { field: 'FullName', headerText: 'Name', width: 180 },
                { field: 'Email', headerText: 'Email', width: 200 },
                { field: 'Role', headerText: 'Role', width: 120 },
                {
                    headerText: 'Actions',
                    template: function (data) {
                        const isCurrentUser = data.Id === currentUserId;

                        return `
                            <div class="d-flex justify-content-center gap-1">
                                <button class="e-btn e-warning" onclick="location.href='/AdminDashboard/Users/Edit/${data.Id}'">
                                    <i class="fas fa-pen"></i> Edit
                                </button>
                                <button class="e-btn e-primary" onclick="location.href='/AdminDashboard/Users/Details/${data.Id}'">
                                    <i class="fas fa-eye"></i> Details
                                </button>
                                <button class="e-btn e-danger"
                                        ${isCurrentUser ? 'disabled title="You cannot delete yourself"' : `onclick="showDeleteModal('${data.Id}', '${data.FullName}')"`}>
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>`;
                    },
                    width: 300,
                    textAlign: 'Center'
                }
            ]
        });

        grid.appendTo('#UsersGrid');

        function showDeleteModal(id, name) {
            document.getElementById('userName').innerText = name;
            document.getElementById('userIdToDelete').value = id;
            document.getElementById('deleteForm').action = `/AdminDashboard/Users/Delete/${id}`;

            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
