@model SchoolManagement.Web.Models.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 900px;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Edit User</h2>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="off" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" asp-items="new SelectList(Model.Roles)" class="form-select"></select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Current Profile Picture:</label>
                        <div class="mb-2">
                            <img src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl)
                                                                      ? "/images/default-profile.png"
                                                                      : $"https://blobainek.blob.core.windows.net/projetspictures/{Model.ProfilePictureUrl}")"
                                 alt="Profile Picture"
                                 class="rounded-circle"
                                 style="width: 100px; height: 100px; object-fit: cover;" />
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Upload New Profile Picture</label>
                        <input asp-for="ProfilePicture" type="file" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <ejs-button id="btnEditUser"
                                type="submit"
                                content="Save Changes"
                                iconCss="fas fa-edit"
                                cssClass="e-success e-plus"
                                iconPosition="Left">
                    </ejs-button>

                    <ejs-button id="btnBackToUsers"
                                type="button"
                                content="Back"
                                iconCss="fas fa-arrow-left"
                                cssClass="e-secondary e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Users'">
                    </ejs-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
