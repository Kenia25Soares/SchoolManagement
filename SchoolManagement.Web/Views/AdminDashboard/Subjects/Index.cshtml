@model IEnumerable<SchoolManagement.Web.Models.SubjectViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Subjects";
}

<div class="container-fluid">
    <h1 class="mt-4">Admin Dashboard</h1>
    <p>Welcome to the management panel.</p>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Subjects</h5>

                    <ejs-button id="btnAddSubject"
                                cssClass="e-success mb-3"
                                content="Add New Subject"
                                iconCss="fas fa-book-medical"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Subjects/Create'">
                    </ejs-button>

                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Workload (hours)</th>
                                <th>Allowed Absences</th>
                                <th style="width: 25%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in Model)
                            {
                                <tr>
                                    <td>@subject.Name</td>
                                    <td>@subject.Workload</td>
                                    <td>@subject.AllowedAbsences</td>
                                    <td>
                                        <ejs-button id="btnEdit-@subject.Id"
                                                    content="Edit"
                                                    iconCss="fas fa-pen"
                                                    cssClass="e-warning e-plus me-1"
                                                    onclick="location.href='/AdminDashboard/Subjects/Edit/@subject.Id'">
                                        </ejs-button>

                                        <ejs-button id="btnDetails-@subject.Id"
                                                    content="Details"
                                                    iconCss="fas fa-eye"
                                                    cssClass="e-primary e-plus me-1"
                                                    onclick="location.href='/AdminDashboard/Subjects/Details/@subject.Id'">
                                        </ejs-button>

                                        <ejs-button id="btnDelete-@subject.Id"
                                                    content="Delete"
                                                    iconCss="fas fa-trash"
                                                    cssClass="e-danger e-plus"
                                                    data-id="@subject.Id"
                                                    data-name="@subject.Name">
                                        </ejs-button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the subject:</p>
                <h6 id="subjectName"></h6>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="subjectIdToDelete" />

                    <ejs-button id="confirmDeleteBtn"
                                type="submit"
                                content="Delete"
                                iconCss="fas fa-trash"
                                cssClass="e-danger">
                    </ejs-button>

                    <ejs-button id="cancelDeleteBtn"
                                content="Cancel"
                                iconCss="fas fa-times"
                                cssClass="e-secondary"
                                onclick="bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); return false;">
                    </ejs-button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll("[id^='btnDelete-']").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const id = btn.getAttribute("data-id");
                    const name = btn.getAttribute("data-name");

                    document.getElementById('subjectName').innerText = name;
                    document.getElementById('subjectIdToDelete').value = id;
                    document.getElementById('deleteForm').action = `/AdminDashboard/Subjects/Delete/${id}`;

                    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                    modal.show();
                });
            });
        });
    </script>
}
