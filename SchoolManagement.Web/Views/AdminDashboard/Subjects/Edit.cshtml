@model SchoolManagement.Web.Models.SubjectViewModel

@{
    ViewData["Title"] = "Edit Subject";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 900px;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Edit Subject</h2>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Workload" class="form-label"></label>
                        <input asp-for="Workload" type="number" class="form-control" autocomplete="off" min="1" max="500" />
                        <span asp-validation-for="Workload" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AllowedAbsences" class="form-label"></label>
                        <input asp-for="AllowedAbsences" type="number" class="form-control" min="0" autocomplete="off" />
                        <span asp-validation-for="AllowedAbsences" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
