@model SchoolManagement.Web.Models.SubjectViewModel

@{
    ViewData["Title"] = "Subject Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto p-4" style="max-width: 900px;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Subject Details</h2>

            <form>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Name</label>
                        <input class="form-control" value="@Model.Name" readonly />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Workload (hours)</label>
                        <input class="form-control" value="@Model.Workload" readonly />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Allowed Absences</label>
                        <input class="form-control" value="@Model.AllowedAbsences" readonly />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <ejs-button id="btnBackToSubjects"
                                type="button"
                                content="Back"
                                iconCss="fas fa-arrow-left"
                                cssClass="e-secondary e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Subjects'">
                    </ejs-button>

                    <ejs-button id="btnEditSubject"
                                type="button"
                                content="Edit"
                                iconCss="fas fa-edit"
                                cssClass="e-warning e-plus"
                                iconPosition="Left"
                                onclick="location.href='/AdminDashboard/Subjects/Edit/@Model.Id'">
                    </ejs-button>
                </div>
            </form>
        </div>
    </div>
</div>
