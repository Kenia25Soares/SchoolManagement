@using Syncfusion.EJ2
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - School Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Raleway:500,800" rel="stylesheet">
    <link href="https://cdn.syncfusion.com/ej2/30.1.37/bootstrap5.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span class="navbar-brand">School Management</span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var pictureUrl = ViewData["ProfilePictureUrl"] as string;

                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(pictureUrl))
                    {
                        <img src="https://blobainek.blob.core.windows.net/projetspictures/@pictureUrl"
                             alt="Profile Picture"
                             class="rounded-circle"
                             style="width: 35px; height: 35px; object-fit: cover;"
                             onerror="this.onerror=null; this.replaceWith(document.createTextNode('No image'));" />
                    }
                    else
                    {
                        <span>No image</span>
                    }

                    <span class="text-white">@User.Identity.Name</span>

                    @if (User.IsInRole("Student"))
                    {
                        <form method="get" asp-controller="Account" asp-action="EditStudentProfile" class="me-1">
                            <ejs-button id="btnEditStudentProfile"
                                        type="submit"
                                        content="Edit"
                                        iconCss="fas fa-user-edit"
                                        cssClass="e-outline e-light e-plus"
                                        iconPosition="Left">
                            </ejs-button>
                        </form>
                    }
                    else
                    {
                        <form method="get" asp-controller="Account" asp-action="EditProfile" class="me-1">
                            <ejs-button id="btnEditProfile"
                                        type="submit"
                                        content="Edit"
                                        iconCss="fas fa-user-cog"
                                        cssClass="e-outline e-light e-plus"
                                        iconPosition="Left">
                            </ejs-button>
                        </form>
                    }

                    <form method="post" asp-controller="Account" asp-action="Logout">
                        <ejs-button id="btnLogout"
                                    type="submit"
                                    content="Logout"
                                    iconCss="fas fa-sign-out-alt"
                                    cssClass="e-outline e-light e-plus"
                                    iconPosition="Left">
                        </ejs-button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <!-- Sidebar -->
    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
    {
        <div class="sidebar pt-5">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
            }
            else if (User.IsInRole("Employee"))
            {
                <a asp-controller="EmployeeDashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="EmployeeAlerts" asp-action="Create">Add Alert</a>
            }
        </div>
    }

    <!-- Page Content -->
    <div class="content-wrapper pt-5">
        @await Html.PartialAsync("_Notification")
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/30.1.37/dist/ej2.min.js"></script>
    @Html.EJS().ScriptManager()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
