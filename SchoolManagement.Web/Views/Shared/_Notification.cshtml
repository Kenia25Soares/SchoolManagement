@{
    var alerts = new Dictionary<string, string>
    {
        { "SuccessMessage", "success" },
        { "ErrorMessage", "danger" },
        { "InfoMessage", "info" },
        { "WarningMessage", "warning" }
    };
}

@foreach (var alert in alerts)
{
    if (TempData[alert.Key] != null)
    {
        <div id="flash-message" class="alert alert-@alert.Value alert-dismissible fade show flash-message" role="alert">
            @TempData[alert.Key]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var msg = document.getElementById('flash-message');
                if (msg) {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(msg);
                    bsAlert.close();
                }
            }, 5000);
        </script>
        break;
    }
}
