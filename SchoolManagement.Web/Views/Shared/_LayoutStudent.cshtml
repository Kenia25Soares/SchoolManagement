@using Syncfusion.EJ2
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - School Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.syncfusion.com/ej2/30.1.37/bootstrap5.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span class="navbar-brand">School Management</span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var pictureUrl = ViewData["ProfilePictureUrl"] as string;

                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(pictureUrl))
                    {
                        <img src="@(string.IsNullOrEmpty(pictureUrl)
                                                         ? "/images/default-profile.png"
                                                         : $"https://blobainek.blob.core.windows.net/projetspictures/{pictureUrl}")"
                     class="rounded-circle" style="width: 35px; height: 35px; object-fit: cover;" />
                                }
                    <span class="text-white">@User.Identity.Name</span>

                    <form method="get" asp-controller="Account" asp-action="EditStudentProfile" class="me-2">
                        <button type="submit" class="btn btn-sm btn-outline-light">Edit Profile</button>
                    </form>

                    <form method="post" asp-controller="Account" asp-action="Logout">
                        <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <!-- Page Content -->
    <div class="container mt-5" style="padding-top: 20px;">
        @RenderBody()
    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
