@model List<SchoolManagement.Web.Data.Entities.StudentClass>

@{
    ViewData["Title"] = "Our Classes";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Discover Our School Classes</h1>
        <p class="lead text-muted">Explore all active classes and the subjects included in each program.</p>
    </div>

    <div class="accordion" id="classesAccordion">
        @for (int i = 0; i < Model.Count; i++)
        {
            var studentClass = Model[i];
            var course = studentClass.Course;
            var subjects = course?.CourseSubjects?.Select(cs => cs.Subject).ToList();

            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@i">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@i" aria-expanded="false" aria-controls="collapse-@i">
                        @studentClass.Name — Course: @course?.Name
                    </button>
                </h2>
                <div id="collapse-@i" class="accordion-collapse collapse" aria-labelledby="heading-@i" data-bs-parent="#classesAccordion">
                    <div class="accordion-body">
                        @if (subjects != null && subjects.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var subject in subjects)
                                {
                                    <li class="list-group-item">@subject.Name</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No subjects found for this class.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

